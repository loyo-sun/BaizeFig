diff --git a/src/style.css b/src/style.css
index bb72e28..4c7f641 100644
--- a/src/style.css
+++ b/src/style.css
@@ -3687,3 +3687,74 @@ html[lang="zh-CN"] .layer-title-input {
   padding: 4px 0;
   line-height: 20px;
 }
+
+/* Canvas navigation: explicit value entry, compact presets and contextual actions. */
+.zoom-control {
+  margin-left: auto;
+  position: relative;
+}
+.zoom-control > .inspector-zoom {
+  min-width: 62px;
+  height: 28px;
+  padding: 0 6px;
+  border-radius: 5px;
+  font-variant-numeric: tabular-nums;
+}
+.zoom-control > .inspector-zoom[aria-expanded="true"] {
+  background: var(--accent);
+  color: var(--green);
+}
+.zoom-control .zoom-menu {
+  top: 34px;
+  right: 0;
+  width: 244px;
+  padding: 8px;
+}
+.zoom-entry {
+  padding: 4px;
+}
+.zoom-entry > label {
+  display: block;
+  font-weight: 600;
+  margin-bottom: 8px;
+}
+.zoom-entry > div {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.zoom-entry input {
+  min-width: 0;
+  font-variant-numeric: tabular-nums;
+}
+.zoom-entry button {
+  flex-shrink: 0;
+  width: 32px;
+  height: 32px;
+  border-radius: 5px;
+  background: var(--accent);
+  color: var(--green);
+}
+.zoom-entry small {
+  display: block;
+  margin-top: 6px;
+  color: #687168;
+  font-size: 10px;
+}
+.zoom-presets {
+  display: flex;
+  gap: 4px;
+  margin: 8px 4px;
+}
+.zoom-presets button {
+  flex: 1;
+  padding: 7px 0;
+  border: 1px solid var(--line);
+  border-radius: 4px;
+  font-size: 11px;
+}
+.zoom-presets button[aria-pressed="true"] {
+  background: var(--accent);
+  border-color: #6b946f;
+  color: var(--green);
+}
