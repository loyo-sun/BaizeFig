# Copy to .env and replace both tokens with independently generated random values.
# Start with: node --env-file=.env bridge/server.mjs --http
BAIZEFIG_HOST=127.0.0.1
BAIZEFIG_PORT=4319
BAIZEFIG_ACCESS_TOKEN=replace-with-an-independent-random-token-of-at-least-32-characters
BAIZEFIG_PAIRING_TOKEN=replace-with-an-independent-random-token-of-at-least-24-characters
# Exact browser origins, comma separated; no trailing slash or wildcard.
BAIZEFIG_ORIGINS=https://design.example.com
# Hostnames received by Node after the reverse proxy; no scheme or port.
BAIZEFIG_HOSTS=design.example.com,127.0.0.1,localhost

# Optional OAuth mode for clients that cannot send a custom static token:
# BAIZEFIG_AUTH_MODE=oauth
# BAIZEFIG_PUBLIC_URL=https://design.example.com
# Local stdio ONLY: opt in to pairing initiated by a trusted editor Origin.
# BAIZEFIG_AUTO_PAIR=1
