{
  "name": "baizefig",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "bridge": "node bridge/server.mjs",
    "format": "prettier --write src bridge scripts tests *.ts *.json *.html",
    "benchmark": "vitest run tests/performance.test.ts",
    "mcp:http": "node bridge/server.mjs --http",
    "test:mcp": "node --test tests/mcp-contracts.test.mjs tests/mcp-transport.test.mjs tests/mcp-oauth.test.mjs tests/mcp-setup.test.mjs",
    "test:mcp:ui": "playwright test --config playwright.mcp.config.ts",
    "mcp:connect": "node scripts/connect-client.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xmldom/xmldom": "^0.9.12",
    "clipper-lib": "^6.4.2",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "idb": "^8.0.0",
    "kiwi-schema": "^0.5.0",
    "lucide-react": "^0.468.0",
    "paper": "^0.12.18",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/clipper-lib": "^6.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "test-dom-jsdom": "npm:jsdom@^29.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
