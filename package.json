{
  "name": "baizefig",
  "version": "0.0.1-beta.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "bridge": "node bridge/server.mjs",
    "format": "prettier --write src bridge scripts tests *.ts *.json *.html",
    "benchmark": "vitest run tests/performance.test.ts",
    "mcp:http": "node bridge/server.mjs --http",
    "test:mcp": "node --test tests/mcp-contracts.test.mjs tests/mcp-transport.test.mjs tests/mcp-oauth.test.mjs tests/mcp-setup.test.mjs",
    "test:mcp:ui": "playwright test --config playwright.mcp.config.ts",
    "mcp:connect": "node scripts/connect-client.mjs",
    "release:version": "node scripts/release-version.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && node scripts/package-mac.mjs --dir",
    "desktop:mac": "npm run build && node scripts/package-mac.mjs",
    "test:desktop": "node --test tests/desktop-open-files.test.mjs tests/desktop-config.test.mjs tests/desktop-adapter.test.mjs tests/desktop-releases.test.mjs",
    "test:desktop:files": "node scripts/desktop-file-open-smoke.mjs",
    "test:desktop:ui": "node scripts/desktop-smoke.mjs",
    "postinstall": "node scripts/install-desktop-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xmldom/xmldom": "^0.9.12",
    "clipper-lib": "^6.4.2",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "idb": "^8.0.0",
    "kiwi-schema": "^0.5.0",
    "lucide-react": "^0.468.0",
    "paper": "^0.12.18",
    "pdf-lib": "^1.17.1",
    "pinyin-pro": "^3.29.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semver": "^7.8.5",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/clipper-lib": "^6.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.10",
    "test-dom-jsdom": "npm:jsdom@^29.1.1",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "displayVersion": "v0.0.1b2",
  "main": "desktop/main.mjs",
  "description": "BaizeFig local-first design editor with local MCP",
  "author": "Loyo"
}
